[Unit]
Description=Raspberry Pi Zero UDP to CRSF bridge
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=REPLACE_WITH_USER
SupplementaryGroups=dialout
WorkingDirectory=/REPLACE_WITH_ABSOLUTE_REPO_PATH
ExecStart=/REPLACE_WITH_ABSOLUTE_REPO_PATH/.venv/bin/python -m pi_zero.main
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
